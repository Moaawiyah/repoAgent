REPOAGENT_DATA_DIR=~/.repoagent
REPOAGENT_LOG_LEVEL=INFO
# REPOAGENT_MAX_RETRIES is inactive; EXECUTION_TIMEOUT is the M7 per-command timeout:
REPOAGENT_MAX_RETRIES=3
REPOAGENT_CONTEXT_BUDGET=16000
REPOAGENT_EXECUTION_TIMEOUT=300
# Retrieval (M3):
REPOAGENT_EMBEDDING_PROVIDER=hashing
REPOAGENT_EMBEDDING_DIMENSION=256
# Investigation agent (M5): none | groq | openai
# "openai" also serves any OpenAI-compatible endpoint via REPOAGENT_LLM_BASE_URL,
# e.g. z.ai: provider=openai, base_url=https://api.z.ai/api/paas/v4/, model=glm-4.7-flashx
REPOAGENT_LLM_PROVIDER=none
REPOAGENT_LLM_MODEL=openai/gpt-oss-20b
REPOAGENT_LLM_API_KEY=
# REPOAGENT_LLM_BASE_URL=https://api.openai.com/v1
REPOAGENT_INVESTIGATION_MAX_ITERATIONS=3
REPOAGENT_INVESTIGATION_MAX_QUERIES=8
REPOAGENT_INVESTIGATION_MAX_EVIDENCE=12
REPOAGENT_INVESTIGATION_MAX_TOOL_CALLS=30
REPOAGENT_INVESTIGATION_CONTEXT_CHARS=12000
REPOAGENT_LLM_TIMEOUT=60
REPOAGENT_LLM_MAX_OUTPUT_TOKENS=2000
REPOAGENT_REPAIR_MAX_REVISIONS=2
# Provider rate limits: proactive throttle (unset = off) plus bounded 429 retries.
# REPOAGENT_LLM_TOKENS_PER_MINUTE=8000
# REPOAGENT_LLM_REQUESTS_PER_MINUTE=30
REPOAGENT_LLM_RATE_LIMIT_RETRIES=4
REPOAGENT_LLM_RATE_LIMIT_MAX_WAIT=60
# Sandboxed validation (M7; used only by `repair --execute`):
REPOAGENT_REPAIR_MAX_ATTEMPTS=3
REPOAGENT_REPAIR_MAX_REINVESTIGATIONS=1
REPOAGENT_SANDBOX_IMAGE=python:3.12-slim
REPOAGENT_SANDBOX_MEMORY_MB=1024
REPOAGENT_SANDBOX_CPUS=2.0
REPOAGENT_SANDBOX_PIDS_LIMIT=256
REPOAGENT_SANDBOX_MAX_OUTPUT_BYTES=64000
REPOAGENT_SANDBOX_INSTALL_TIMEOUT=600
REPOAGENT_SANDBOX_NETWORK=install_only
REPOAGENT_SANDBOX_DEPENDENCIES=project
REPOAGENT_SANDBOX_CLEANUP=always
# REPOAGENT_SANDBOX_WORKSPACE_DIR=/private/tmp/repoagent-sandbox
# API (M8; `repoagent serve`). Lists are JSON arrays.
# REPOAGENT_API_ALLOWED_ROOTS=["/path/to/repositories"]
# REPOAGENT_API_EXECUTION_REPOSITORIES=["/path/to/repositories/demo"]
# REPOAGENT_API_TOKEN=required-for-non-loopback-hosts
REPOAGENT_API_MAX_WORKERS=1
# Web workflows: GitHub repositories are fetched (never executed) on the host
# into <data-dir>/workspaces. Docker validation of fetched repositories is
# limited to "owner/name" entries here ("*" allows any; use with care).
REPOAGENT_API_ALLOW_GITHUB=true
# REPOAGENT_API_EXECUTION_GITHUB=["owner/name"]
REPOAGENT_GITHUB_CLONE_TIMEOUT=300
REPOAGENT_GITHUB_MAX_REPOSITORY_MB=200
# Deterministic workflow limits (no LLM watchdog agent).
REPOAGENT_DISCOVERY_MAX_CANDIDATES=25
REPOAGENT_WORKFLOW_MAX_LLM_CALLS=200
# REPOAGENT_WORKFLOW_MAX_TOKENS=2000000
REPOAGENT_WORKFLOW_TASK_TIMEOUT=1800
